<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/style.css"/>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="../js/edit.js"></script>
    <title>Edit Book</title>
</head>
<body>
    <div class="form-container">
        <h1>Edit Book Details</h1>
        <p class="subtitle">
            Update the book's latest details to your personal reading collection.
        </p>
        <p style="color:red">* Required Field</p>
        <form id="bookInfo" action="/edit/<%= book.id %>">
            <div class="form-group">
                <label><span class="asterik">*</span> Book Title :</label>
                <input type="text" name="title" value="<%= book.title %>">
            </div>
            
            <div class="form-group">
                <label><span class="asterik">*</span> Author :</label>
                <input type="text" name="author" value="<%= book.author %>">
            </div>

            <div class="form-group">
                <label><span class="asterik">*</span> ISBN :</label>
                <input type="text" name="isbn" value="<%= book.isbn %>">
            </div>
            
            <div class="form-group">
                <label><span class="asterik">*</span> Date Reading :</label>
                <input type="date" name="readDate" value="<%= book.read_date %>">
            </div>

            <div class="form-group">
                <label><span class="asterik">*</span> Rating :</label>
                <select name="rating">
                    <option value="">Please select a rating</option>
                    <% for(let i=1; i<=5; i++) { %>
                    <option 
                        value="<%= i %>" 
                        <%= book.rating == i ? "selected" : ""%>>
                        <%="⭐".repeat(i)%> (<%= i %>)
                    </option>
                    <% } %>
                </select>
            </div>
            
            <div class="form-group">
                <label>Review (Optional):</label>
                <textarea name="review"><%= book.review %></textarea>
            </div>

            <div class="form-buttons">
                <a href="/" class="btn btn-cancel">Cancel</a>
                <input type="submit" value="Save Book">
            </div>
        </form>
    </div>
</body>
</html>